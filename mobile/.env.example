# Mobile environment. Only EXPO_PUBLIC_* values reach the app, and everything
# that does is readable inside the shipped bundle.
#
# The anon key belongs here — it is constrained by the RLS policies in
# config/schema.sql. The SERVICE ROLE key must never appear in this file; it
# bypasses every one of those policies.

# Your machine's LAN IP during development — "localhost" resolves to the phone
# itself, not your computer.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_MAPTILER_KEY=your-maptiler-key

# Hides the Google button while false.
EXPO_PUBLIC_ENABLE_GOOGLE_OAUTH=false

EAS_PROJECT_ID=
