#-----------------------------------------------------------------------------
# Territory Runner — environment
# Copy to .env and fill in. Never commit .env.
#-----------------------------------------------------------------------------

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

#-----------------------------------------------------------------------------
# Supabase
#
# Dashboard -> Project Settings -> Database -> Connection string
#   DATABASE_URL : "Transaction pooler" / Supavisor, port 6543. Used by the app.
#   DIRECT_URL   : "Direct connection",   port 5432. Used by migrations only.
#
# Dashboard -> Project Settings -> API
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Dashboard -> Project Settings -> API -> JWT Settings
#   SUPABASE_JWT_SECRET
#
# Before first run: Database -> Extensions -> enable "postgis".
#-----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
# SERVER-SIDE ONLY. Bypasses every RLS policy. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Used to verify incoming JWTs (HS256).
SUPABASE_JWT_SECRET=your-super-secret-jwt-token

#-----------------------------------------------------------------------------
# OAuth
# Google: configure the provider in Supabase (Authentication -> Providers),
# then add the Supabase callback URL to the Google Cloud console. No client
# secret is needed here — Supabase holds it.
#
# Facebook needs Business verification and a privacy-policy URL before it
# leaves dev mode, so it stays off until you have that. Flip to true once the
# provider is enabled in the Supabase dashboard.
#-----------------------------------------------------------------------------
ENABLE_FACEBOOK_OAUTH=false
# Hides the Google buttons on web and mobile while false. Turn on only after
# creating the Google Cloud OAuth client and enabling the provider in Supabase.
ENABLE_GOOGLE_OAUTH=false

#-----------------------------------------------------------------------------
# Maps — MapTiler (free tier: 100k tile loads/month)
# https://cloud.maptiler.com/account/keys/
# The previous build hotlinked tile.openstreetmap.org directly, which breaks
# OSM's tile usage policy.
#-----------------------------------------------------------------------------
MAPTILER_KEY=
MAPTILER_STYLE=streets-v2

#-----------------------------------------------------------------------------
# Reverse geocoding — resolves a run's centre to a place name ONCE on finish,
# cached on the row. 'nominatim' needs no key but is rate-limited to 1 req/s
# and requires a real User-Agent. 'geoapify' needs a key. 'none' disables it
# (summaries then omit the "places visited most" section).
#-----------------------------------------------------------------------------
GEOCODER_PROVIDER=nominatim
GEOAPIFY_KEY=
GEOCODER_USER_AGENT=TerritoryRunner/2.0 (contact@example.com)
