<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-ink-100">

  <main class="flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm">

      <div class="mb-6 flex flex-col items-center gap-2 text-center">
        <h1 class="text-lg">Territory Runner</h1>
        <p class="text-sm text-ink-500">Sign in to claim your ground.</p>
      </div>

      <div class="card card-pad">

        <!-- OAuth first: it is the path most people will take, and Supabase
             handles account linking by verified email so this cannot create a
             duplicate of an existing email/password account.

             Both providers are off unless explicitly enabled, so production
             shows email/password only until the Google client exists and the
             provider is switched on in the Supabase dashboard. -->
        <% if (enableGoogle) { %>
        <button type="button" id="btn-google" class="btn-oauth">
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.8-6.8C35.6 2.4 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.2C12.4 13.6 17.7 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-2.8-.4-4.1H24v8.1h12.5c-.3 2.1-1.6 5.2-4.6 7.3l7.7 6c4.5-4.2 6.5-10.2 6.5-17.3z"/>
            <path fill="#FBBC05" d="M10.5 28.6a14.6 14.6 0 0 1 0-9.2l-7.9-6.2a24 24 0 0 0 0 21.6l7.9-6.2z"/>
            <path fill="#34A853" d="M24 48c6.2 0 11.5-2 15.6-5.6l-7.7-6c-2.1 1.4-4.8 2.4-7.9 2.4-6.3 0-11.6-4.1-13.5-9.9l-7.9 6.2C6.5 42.6 14.6 48 24 48z"/>
          </svg>
          Continue with Google
        </button>
        <% } %>

        <% if (enableFacebook) { %>
        <button type="button" id="btn-facebook" class="btn-oauth mt-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true">
            <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.95H15.83c-1.5 0-1.96.93-1.96 1.89v2.27h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/>
          </svg>
          Continue with Facebook
        </button>
        <% } %>

        <% if (enableGoogle || enableFacebook) { %>
        <div class="my-4 flex items-center gap-3">
          <span class="h-px flex-1 bg-ink-200"></span>
          <span class="text-xs text-ink-400">or</span>
          <span class="h-px flex-1 bg-ink-200"></span>
        </div>
        <% } %>

        <form id="login-form" novalidate>
          <div class="mb-3">
            <label class="label" for="email">Email</label>
            <input class="input" type="email" id="email" name="email"
                   autocomplete="email" required placeholder="you@example.com">
          </div>
          <div class="mb-4">
            <label class="label" for="password">Password</label>
            <input class="input" type="password" id="password" name="password"
                   autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn-primary btn-block" id="btn-submit">Sign in</button>
        </form>

        <p class="mt-4 text-center text-sm text-ink-500">
          No account? <a href="/signup" class="font-medium text-accent-600 hover:underline">Create one</a>
        </p>
      </div>

      <p class="mt-4 text-center text-xs text-ink-400" id="form-message" role="status"></p>
    </div>
  </main>

  <div class="toast-stack" id="toast-stack" aria-live="polite"></div>

  <%- include('partials/config') %>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/auth.js"></script>
  <script src="/js/auth-page.js"></script>
</body>
</html>
