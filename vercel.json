{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:css",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{views,shared,public}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
